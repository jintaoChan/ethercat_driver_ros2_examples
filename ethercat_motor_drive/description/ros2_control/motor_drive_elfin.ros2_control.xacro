<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="motor_drive">

    <ros2_control name="motor_drive" type="system">
      <hardware>
        <plugin>ethercat_driver/EthercatDriver</plugin>
        <param name="master_id">0</param>
        <param name="control_frequency">1000</param>
        <!-- <plugin>mock_components/GenericSystem</plugin> -->

      </hardware>

      <joint name="joint0">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="mode"/>
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <command_interface name="reset_fault"/>
        <command_interface name="mode"/>
        <ec_module name="elfin">
          <plugin>ethercat_generic_plugins/ECMutilAxisDrive</plugin>
          <param name="alias">0</param>
          <param name="position">0</param>
          <param name="axis">2</param>
          <param name="mode_of_operation">8</param>
          <param name="slave_config">$(find ethercat_motor_drive)/config/elfin_module1.yaml</param>
        </ec_module>
      </joint>

      <joint name="joint1">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="mode"/>
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <command_interface name="reset_fault"/>
        <command_interface name="mode"/>
        <ec_module name="elfin">
          <plugin>ethercat_generic_plugins/ECMutilAxisDrive</plugin>
          <param name="alias">0</param>
          <param name="position">0</param>
          <param name="axis">1</param>
          <param name="mode_of_operation">8</param>
          <param name="slave_config">$(find ethercat_motor_drive)/config/elfin_module1.yaml</param>
        </ec_module>
      </joint>

      <joint name="joint2">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="mode"/>
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <command_interface name="reset_fault"/>
        <command_interface name="mode"/>
        <ec_module name="elfin">
          <plugin>ethercat_generic_plugins/ECMutilAxisDrive</plugin>
          <param name="alias">0</param>
          <param name="position">1</param>
          <param name="axis">1</param>
          <param name="mode_of_operation">8</param>
          <param name="slave_config">$(find ethercat_motor_drive)/config/elfin_module2.yaml</param>
        </ec_module>
      </joint>

      <joint name="joint3">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="mode"/>
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <command_interface name="reset_fault"/>
        <command_interface name="mode"/>
        <ec_module name="elfin">
          <plugin>ethercat_generic_plugins/ECMutilAxisDrive</plugin>
          <param name="alias">0</param>
          <param name="position">1</param>
          <param name="axis">2</param>
          <param name="mode_of_operation">8</param>
          <param name="slave_config">$(find ethercat_motor_drive)/config/elfin_module2.yaml</param>
        </ec_module>
      </joint>

      <joint name="joint4">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="mode"/>
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <command_interface name="reset_fault"/>
        <command_interface name="mode"/>
        <ec_module name="elfin">
          <plugin>ethercat_generic_plugins/ECMutilAxisDrive</plugin>
          <param name="alias">0</param>
          <param name="position">2</param>
          <param name="axis">1</param>
          <param name="mode_of_operation">8</param>
          <param name="slave_config">$(find ethercat_motor_drive)/config/elfin_module3.yaml</param>
        </ec_module>
      </joint>

      <joint name="joint5">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="mode"/>
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <command_interface name="reset_fault"/>
        <command_interface name="mode"/>
        <ec_module name="elfin">
          <plugin>ethercat_generic_plugins/ECMutilAxisDrive</plugin>
          <param name="alias">0</param>
          <param name="position">2</param>
          <param name="axis">2</param>
          <param name="mode_of_operation">8</param>
          <param name="slave_config">$(find ethercat_motor_drive)/config/elfin_module3.yaml</param>
        </ec_module>
      </joint>


    </ros2_control>

  </xacro:macro>

</robot>
